# ============================================================
# Implementation Pro — environment template
# Copy to .env.local and fill values. Run: npm run verify:env
# ============================================================

# Supabase (required)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Server-only: webhooks, ingest script, admin batch (required for Stripe webhook + waitlist + support:ingest)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# App URLs (required for Stripe redirect URLs in production)
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Implementation Pro

# AI — agents & support chat (required for agent execution + Help assistant)
ANTHROPIC_API_KEY=your_anthropic_api_key

# AI — embeddings for semantic support RAG (optional; keyword KB still works without)
OPENAI_API_KEY=sk-your-openai-key-for-text-embedding-3-small

# Stripe (required for paid plans + checkout + portal)
STRIPE_SECRET_KEY=sk_live_or_test
NEXT_PUBLIC_STRIPE_PRO_PRICE_ID=price_...
NEXT_PUBLIC_STRIPE_TEAM_PRICE_ID=price_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Email — Resend (optional)
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=updates@your-domain.com
